# .claudeignore — copy to project root as .claudeignore
# Prevents Claude Code from reading these during file/directory operations.
# 80%+ context reduction on large projects (node_modules, build artifacts).
#
# Auto-deployed to new git projects via the dotfiles Stop hook.
# Edit per project to match your actual structure.

# Dependencies
node_modules/
vendor/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.output/
target/

# Lock files (large, low signal)
package-lock.json
yarn.lock
pnpm-lock.yaml
Cargo.lock
poetry.lock
Gemfile.lock
composer.lock

# Test coverage
coverage/
.nyc_output/
htmlcov/
lcov.info
*.lcov

# Version control internals
.git/

# Caches and generated
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
